datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Conventions MySQL de ce schéma :
// - Identifiants UUID : VarChar(36) explicite (au lieu du VarChar(191) par défaut de Prisma)
//   pour garder des index compacts.
// - Champs pouvant dépasser 191 caractères : @db.VarChar(n), @db.Text ou @db.LongText.
//   MySQL tronque/refuse silencieusement au-delà de la taille déclarée, contrairement au
//   type `text` illimité de PostgreSQL : chaque champ long est donc typé explicitement.

model Company {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  name                  String    @db.VarChar(191)
  nif                   String?   @db.VarChar(64) // Numéro d'Identification Fiscale (TVA, etc.)
  email                 String?   @db.VarChar(191)
  phone                 String?   @db.VarChar(32)
  address               String?   @db.VarChar(500)
  logoUrl               String?   @db.Text // URL publique du logo stocké dans S3
  subscriptionPlan      String    @default("FREE") @db.VarChar(20) // "FREE", "STANDARD", "PREMIUM"
  subscriptionExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users                 User[]
  projects              Project[]
  materials             Material[]
}

model User {
  id          String   @id @default(uuid()) @db.VarChar(36)
  email       String?  @unique @db.VarChar(191)
  password    String   @db.VarChar(255) // hash bcrypt (60 caractères)
  firstName   String   @db.VarChar(100)
  lastName    String   @db.VarChar(100)
  phone       String?  @db.VarChar(32)
  role        String   @default("COMPANY_ADMIN") @db.VarChar(20) // "SUPER_ADMIN", "COMPANY_ADMIN", "TEAM_LEADER", "WORKER", "CLIENT"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String?  @db.VarChar(36)
  company     Company? @relation(fields: [companyId], references: [id])

  assignments ProjectAssignment[]
  progressLogs ProgressPhoto[]
  expenses    Expense[]
  createdPayments   Payment[] @relation("PaymentCreatedBy")
  validatedPayments Payment[] @relation("PaymentValidatedBy")
  mobileMoneyTransactions MobileMoneyTransaction[]
  siteLogEntries SiteLogEntry[]

  @@index([companyId])
}

model Project {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(191)
  description String?  @db.Text
  address     String?  @db.VarChar(500)
  latitude    Float?
  longitude   Float?
  startDate   DateTime
  endDate     DateTime
  budget      Float?   // Budget prévisionnel du chantier (FCFA)
  status      String   @default("EN_COURS") @db.VarChar(20) // "EN_COURS", "TERMINE", "SUSPENDU"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String   @db.VarChar(36)
  company     Company  @relation(fields: [companyId], references: [id])

  assignments ProjectAssignment[]
  expenses    Expense[]
  progressLogs ProgressPhoto[]
  tasks       Task[]
  materials   Material[]
  movements   MaterialMovement[]
  documents   Document[]
  siteLogEntries SiteLogEntry[]

  @@index([companyId])
}

model ProjectAssignment {
  id          String   @id @default(uuid()) @db.VarChar(36)
  projectId   String   @db.VarChar(36)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String   @db.VarChar(36)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

model Expense {
  id          String   @id @default(uuid()) @db.VarChar(36)
  projectId   String   @db.VarChar(36)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Float
  category    String   @db.VarChar(32) // "CIMENT", "SABLE", "TRANSPORT", "MAIN_DOEUVRE", "AUTRE"
  description String   @db.Text
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  beneficiaryId String? @db.VarChar(36)
  beneficiary   User?    @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  devisId       String?   @db.VarChar(36)
  devis         Document? @relation("DevisExpenses", fields: [devisId], references: [id], onDelete: SetNull)
  receiptUrl    String?   @db.Text
  status        String    @default("EN_ATTENTE") @db.VarChar(20) // "EN_ATTENTE", "PAYE_CLIENT", "PAYE"

  @@index([projectId])
  @@index([beneficiaryId])
  @@index([devisId])
}

model ProgressPhoto {
  id          String   @id @default(uuid()) @db.VarChar(36)
  projectId   String   @db.VarChar(36)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photoUrl    String   @db.LongText // URL S3 ou image Base64 en repli si l'envoi S3 échoue
  type        String   @db.VarChar(20) // "AVANT", "APRES", "QUOTIDIEN"
  comment     String?  @db.Text
  takenById   String   @db.VarChar(36)
  takenBy     User     @relation(fields: [takenById], references: [id])
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([takenById])
}

model Task {
  id          String   @id @default(uuid()) @db.VarChar(36)
  projectId   String   @db.VarChar(36)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(191) // "Fondations", "Élévation", "Toiture", "Électricité", "Plomberie", etc.
  status      String   @default("A_FAIRE") @db.VarChar(20) // "A_FAIRE", "EN_COURS", "TERMINE"
  dueDate     DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model Material {
  id            String   @id @default(uuid()) @db.VarChar(36)
  companyId     String   @db.VarChar(36)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId     String?  @db.VarChar(36) // chantier propriétaire ; null = matériau partagé entreprise (legacy, avant scoping par chantier)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(191) // e.g. "Ciment", "Sable"
  stock         Float    @default(0)
  minStockAlert Float    @default(5)
  unit          String   @default("sacs") @db.VarChar(32) // "sacs", "tonnes", etc.
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  movements     MaterialMovement[]

  @@index([companyId])
  @@index([projectId])
}

model MaterialMovement {
  id          String   @id @default(uuid()) @db.VarChar(36)
  materialId  String   @db.VarChar(36)
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  projectId   String?  @db.VarChar(36)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type        String   @db.VarChar(20) // "ENTREE", "SORTIE"
  quantity    Float
  reason      String?  @db.VarChar(255) // e.g. "Achat", "Utilisé sur chantier"
  date        DateTime @default(now())

  @@index([materialId])
  @@index([projectId])
}

model Document {
  id              String    @id @default(uuid()) @db.VarChar(36)
  projectId       String    @db.VarChar(36)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String    @db.VarChar(191)
  type            String    @db.VarChar(20) // "DEVIS", "FACTURE"
  amount          Float
  paidAmount      Float     @default(0)
  declaredPaidAmount Float? @default(0)
  status          String    @default("EN_ATTENTE") @db.VarChar(20) // "EN_ATTENTE", "SIGNE", "PAYE"
  pdfUrl          String?   @db.Text
  clientSignature String?   @db.LongText // URL S3 ou signature Base64 en repli si l'envoi S3 échoue
  signedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  devisId         String?     @db.VarChar(36)
  devis           Document?   @relation("DevisFactures", fields: [devisId], references: [id], onDelete: SetNull)
  factures        Document[]  @relation("DevisFactures")
  expenses        Expense[]   @relation("DevisExpenses")
  payments        Payment[]
  mobileMoneyTransactions MobileMoneyTransaction[]

  @@index([projectId])
  @@index([devisId])
}

model Payment {
  id                String   @id @default(uuid()) @db.VarChar(36)
  documentId        String   @db.VarChar(36)
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  amount            Float
  type              String   @default("ACHATS") @db.VarChar(20) // "MAIN_DOEUVRE", "ACHATS"
  status            String   @default("EN_ATTENTE") @db.VarChar(20) // "EN_ATTENTE", "VALIDE"
  createdAt         DateTime @default(now())

  createdByUserId   String?  @db.VarChar(36)
  createdByUser     User?    @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  validatedByUserId String?  @db.VarChar(36)
  validatedByUser   User?    @relation("PaymentValidatedBy", fields: [validatedByUserId], references: [id], onDelete: SetNull)

  mobileMoneyTransactions MobileMoneyTransaction[]

  @@index([documentId])
  @@index([createdByUserId])
  @@index([validatedByUserId])
}

// Trace de bout en bout d'un encaissement Mobile Money via FedaPay.
// Un paiement approuvé donne naissance à un Payment classique (VALIDE) :
// l'existant (affichage, agrégats, statuts de facture) reste inchangé.
model MobileMoneyTransaction {
  id               String   @id @default(uuid()) @db.VarChar(36)
  // Identifiant de la transaction côté FedaPay — clé d'idempotence du webhook
  fedapayId        Int      @unique
  documentId       String   @db.VarChar(36)
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  paymentId        String?  @db.VarChar(36)
  payment          Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount           Int      // FCFA (XOF) — entier strict, exigé par FedaPay
  provider         String   @db.VarChar(20) // "togocel", "moov_tg", "mtn_bj", ...
  phoneNumber      String   @db.VarChar(32) // numéro local normalisé (sans indicatif)
  status           String   @default("PENDING") @db.VarChar(20) // "PENDING", "APPROVED", "DECLINED", "CANCELED", "EXPIRED", "FAILED"
  fedapayReference String?  @db.VarChar(64)
  failureReason    String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByUserId  String?  @db.VarChar(36)
  createdByUser    User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([status])
  @@index([createdByUserId])
}

model OTPVerification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  phone     String   @unique @db.VarChar(32)
  code      String   @db.VarChar(10)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Cahier des charges : journal quotidien de chantier — une checklist de ce qui a été fait, par date.
model SiteLogEntry {
  id          String   @id @default(uuid()) @db.VarChar(36)
  projectId   String   @db.VarChar(36)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  items       Json     // [{ label: string, done: boolean }]
  createdById String?  @db.VarChar(36)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, date])
  @@index([projectId])
}

model SubscriptionConfig {
  planName     String   @id @db.VarChar(20) // "FREE", "STANDARD", "PREMIUM"
  maxProjects  Int
  maxUsers     Int
  price        Int      @default(0)
  durationDays Int      @default(30) // Durée en jours (ex: 30, 90, 365)
  // VarChar (et non Text) : MySQL n'accepte pas de DEFAULT littéral sur une colonne TEXT.
  features     String   @default("") @db.VarChar(500) // ex: "GEOLOCALISATION,MATERIAUX,DOCUMENTS,PDF"
  updatedAt    DateTime @updatedAt
}
