# === Base de données (MySQL 8.x) ===
# Format : mysql://<user>:<password>@<host>:<port>/<database>
# ⚠️ Encoder les caractères spéciaux du mot de passe (ex: @ -> %40, ! -> %21)
DATABASE_URL=mysql://<user>:<password>@127.0.0.1:3306/constructcare_dev
# Base temporaire utilisée par `prisma migrate dev` pour valider les migrations.
# Requise en développement uniquement ; inutile pour `prisma migrate deploy` en production.
SHADOW_DATABASE_URL=mysql://<user>:<password>@127.0.0.1:3306/constructcare_shadow
# En production, limiter le pool applicatif : ...?connection_limit=10&pool_timeout=20

# === Amorçage de production (seed:prod / démarrage avec NODE_ENV=production) ===
# Requis UNIQUEMENT tant qu'aucun SUPER_ADMIN n'existe en base. Jamais versionnés.
SUPERADMIN_EMAIL=admin@votredomaine.com
SUPERADMIN_PASSWORD=<au_moins_12_caracteres>
# SUPERADMIN_FIRSTNAME=Super
# SUPERADMIN_LASTNAME=Administrateur
# SUPERADMIN_PHONE=+228 90 00 00 00
# Amorçage auto au démarrage : actif si NODE_ENV=production ; forcer avec true/false
# BOOTSTRAP_ON_START=true

# === Sécurité ===
JWT_SECRET=<chaine_aleatoire_forte>          # ex: openssl rand -hex 48
NODE_ENV=production                           # désactive les logs SQL verbeux
# CORS : origines autorisées (séparées par des virgules). OBLIGATOIRE en prod.
CORS_ORIGIN=https://app.votredomaine.com

# === Serveur ===
PORT=3005

# === SMS (AfrikSMS) ===
AFRIK_SMS_API_KEY=
AFRIK_SMS_CLIENT_ID=
AFRIK_SMS_SENDER_ID=
AFRIK_SMS_URL=https://api.afriksms.com/api/web/web_v1/outbounds/send

# === Stockage objets (S3-compatible) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT=
