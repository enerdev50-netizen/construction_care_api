# Copier en .env pour le développement local.
PORT=3001
JWT_SECRET="changez_moi_en_local"

# MySQL local — démarré via `docker compose -f docker-compose.local.yml up -d`
DATABASE_URL="mysql://construction:construction@127.0.0.1:3308/construction"

# --- Optionnel : stockage S3 des logos et pièces jointes ---
# AWS_S3_ENDPOINT="https://hel1.your-objectstorage.com"
# AWS_S3_BUCKET_NAME=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="eu-central-1"

# --- Optionnel : envoi réel des SMS d'OTP ---
# Sans ces variables, le code OTP est uniquement écrit dans les logs du serveur.
# AFRIK_SMS_API_KEY=""
# AFRIK_SMS_CLIENT_ID=""
# AFRIK_SMS_SENDER_ID="Ratoufa"
